<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ requires this to post any notification, including the
         ongoing session notification this module manages. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required to run FocusSessionForegroundService (the ongoing "a
         session is active" presence — see 02-session-notification.md).
         specialUse is the correct Android 14 (API 34+) foreground service
         type here: this isn't mediaPlayback/location/camera/etc, it's a
         bespoke "app enforcement session is active" use case, which is
         exactly what specialUse (+ the PROPERTY_SPECIAL_USE_FGS_SUBTYPE
         declaration below) exists for. Google Play's data-safety/
         declarations form needs a matching justification at submission
         time — not just a code-level requirement. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Lets BootCompletedReceiver restart the ongoing-session notification
         right after a reboot instead of leaving it absent until the next
         real app-switch event. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
          BIND_ACCESSIBILITY_SERVICE on the <service> itself is what makes this
          a real AccessibilityService the system will bind to — it is not a
          normal runtime-requestable permission (no prompt exists for it), the
          user must grant it via system Settings. See BlockingPrefs/the
          Permission Priming spec for the walkthrough this requires.
        -->
        <service
            android:name="expo.modules.blockingenforcement.BlockingAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          singleTask + its own taskAffinity: opens as its own task so the back
          button can never return the user to the blocked app underneath it.
          excludeFromRecents keeps a stray "Blocked" task out of the recents
          switcher after the user leaves it via the CTA. Not exported — only
          ever launched from BlockingAccessibilityService within this app's
          own process, never by another app.
        -->
        <activity
            android:name="expo.modules.blockingenforcement.BlockedAppInterstitialActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/BlockedInterstitialTheme" />

        <!--
          Not exported — only ever started from within this app process
          (BlockingEnforcementModule at session start/end, or
          BlockingAccessibilityService's self-heal restart).
        -->
        <service
            android:name="expo.modules.blockingenforcement.FocusSessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Ongoing focus-session and app-blocking enforcement indicator" />
        </service>

        <!--
          exported="true" because BOOT_COMPLETED is delivered by the system
          (a different UID from this app), not another app on the device —
          BOOT_COMPLETED is a protected broadcast, so only the system can
          actually send it regardless of this flag. The permission
          requirement below is belt-and-suspenders on top of that.
        -->
        <receiver
            android:name="expo.modules.blockingenforcement.BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
