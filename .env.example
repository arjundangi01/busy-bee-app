EXPO_PUBLIC_API_URL=http://localhost:4000/api

# DD-003 Paywall/Upgrade — optional until real RevenueCat account/products exist.
# Purchases.configure() is skipped (with a console warning) while these are unset.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Google social login — the "Web client ID" (not the iOS/Android client ID)
# from Firebase Console > Authentication > Sign-in method > Google. Also
# needs GoogleService-Info.plist and google-services.json at the project
# root (see app.json's googleServicesFile paths). GoogleSignin.configure()
# is skipped (with a console warning) while this is unset.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
